model Shedule {
    id            String    @id @default(uuid())

    startDateTime DateTime
    endDateTime   DateTime

    totalSlots     Int
    availableSlots Int

    meetingLink String
    status      SheduleStatus @default(DRAFT)

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    doctorId String @unique
    doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  appoinment Apppointment[]

    @@unique([doctorId, startDateTime, endDateTime], name: "uniqe_shedule")
    @@map("shedules")
}
